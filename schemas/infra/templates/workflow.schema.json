{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://gitea.localhost:3001/templates/json/raw/branch/main/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "A shallow ordered pipeline. Data contracts live in the steps; runtime concerns live in the run record.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string"
        },
        "manual": {
          "type": "boolean"
        },
        "event": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stepRef"
      }
    },
    "finally": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stepRef"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "runtime_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        },
        "stop_on_item_failure": {
          "type": "boolean"
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "input_object_schema": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "properties": {
        "default_input": {
          "type": "string"
        },
        "default_output": {
          "type": "string"
        },
        "concurrency_lock": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stepRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+@\\d+\\.\\d+\\.\\d+$"
    }
  }
}
