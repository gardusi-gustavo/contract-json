{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://gitea.localhost:3001/templates/json/raw/branch/main/schemas/workflow-step.schema.json",
  "title": "WorkflowStep",
  "description": "A typed transformer with explicit input and output object contracts.",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "timeout_seconds",
    "input_object_schema",
    "output_object_schema",
    "transition",
    "idempotency",
    "side_effects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "control",
        "transform",
        "verify",
        "manual"
      ]
    },
    "description": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "input_object_schema": {
      "type": "string",
      "minLength": 1
    },
    "output_object_schema": {
      "type": "string",
      "minLength": 1
    },
    "failure_object_schema": {
      "type": "string",
      "minLength": 1
    },
    "transition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/stage"
              }
            },
            "to": {
              "$ref": "#/$defs/stage"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "idempotency": {
      "type": "string",
      "minLength": 1
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "state.read",
          "state.write",
          "store.read",
          "store.write",
          "card.read",
          "card.write",
          "docs.write",
          "event.append",
          "file.read",
          "file.write",
          "file.copy",
          "file.rename",
          "file.delete",
          "dump.read",
          "dump.write",
          "service.read",
          "service.stop",
          "service.start",
          "lock.acquire",
          "lock.release",
          "secret.read",
          "secret.write",
          "network.read",
          "network.write"
        ]
      }
    },
    "execution_strategy": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "single",
            "matrix"
          ]
        },
        "iterate_over_input": {
          "type": "string"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wait": {
      "type": "object",
      "required": [
        "for"
      ],
      "properties": {
        "for": {
          "type": "string"
        },
        "reminder_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "required": [
        "key",
        "mode"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "checkpoint",
            "restart"
          ]
        }
      },
      "additionalProperties": false
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "failure_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retry": {
      "type": "object",
      "required": [
        "max_attempts",
        "on"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backoff": {
          "type": "object",
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "fixed",
                "exponential"
              ]
            },
            "initial_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "jitter": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "retention_class"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "retention_class": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "required",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "automatic",
              "manual",
              "log",
              "hash"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "io",
        "cpu",
        "network"
      ],
      "properties": {
        "io": {
          "type": "string",
          "enum": [
            "light",
            "heavy"
          ]
        },
        "cpu": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "network": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "media_profile_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stage": {
      "type": "string",
      "enum": [
        "input",
        "processing",
        "ready",
        "on_card",
        "published",
        "repairing",
        "blocked",
        "review",
        "dupes",
        "quarantine"
      ]
    },
    "check": {
      "type": "object",
      "required": [
        "check"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "field": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "a": {
          "type": "string"
        },
        "b": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
