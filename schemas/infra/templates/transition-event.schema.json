{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://gitea.localhost:3001/templates/json/raw/branch/main/schemas/transition-event.schema.json",
  "title": "TransitionEvent",
  "description": "One append-only vault item state transition.",
  "type": "object",
  "required": ["event_id", "at", "item_id", "from", "to", "reason", "ticket_id", "run_id"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "at": { "type": "string", "format": "date-time" },
    "item_id": { "type": "string", "minLength": 1 },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "reason": { "type": ["string", "null"] },
    "ticket_id": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
