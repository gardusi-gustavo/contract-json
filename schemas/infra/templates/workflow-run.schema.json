{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://gitea.localhost:3001/templates/json/raw/branch/main/schemas/workflow-run.schema.json",
  "title": "WorkflowRun",
  "description": "Runtime state for one workflow execution.",
  "type": "object",
  "required": [
    "run_id",
    "workflow",
    "workflow_version",
    "state",
    "started_at",
    "steps"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "waiting",
        "completed",
        "failed",
        "cancelled",
        "dead_lettered",
        "partial"
      ]
    },
    "trigger": {
      "type": "string",
      "enum": [
        "manual",
        "schedule",
        "event"
      ]
    },
    "current_step": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "waiting_for": {
      "type": [
        "string",
        "null"
      ]
    },
    "waiting_since": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reminder_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "logs_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "attempts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "waiting",
              "done",
              "failed",
              "skipped",
              "dead_lettered"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "error": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
