{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://gitea.localhost:3001/templates/json/raw/branch/main/schemas/vault/objects.schema.json",
  "title": "VaultObjects",
  "description": "Typed objects exchanged between vault workflow steps.",
  "$defs": {
    "itemInput": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "stage": {
              "const": "input"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "store": {
                  "const": true
                },
                "card": {
                  "const": false
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemProcessing": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "stage": {
              "const": "processing"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "store": {
                  "const": true
                },
                "card": {
                  "const": false
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemClassified": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "ticket_id"
          ],
          "properties": {
            "stage": {
              "const": "processing"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "store": {
                  "const": true
                },
                "card": {
                  "const": false
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemReady": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "sha256"
          ],
          "properties": {
            "stage": {
              "const": "ready"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "store": {
                  "const": true
                },
                "card": {
                  "const": false
                }
              },
              "additionalProperties": false
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemVerified": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "sha256",
            "verified",
            "verified_at"
          ],
          "properties": {
            "stage": {
              "const": "ready"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "store": {
                  "const": true
                },
                "card": {
                  "const": false
                }
              },
              "additionalProperties": false
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "verified": {
              "const": true
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemPublished": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "sha256"
          ],
          "properties": {
            "stage": {
              "const": "published"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "card": {
                  "const": true
                }
              },
              "additionalProperties": false
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemOnCard": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "sha256"
          ],
          "properties": {
            "stage": {
              "const": "on_card"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "card": {
                  "const": true
                }
              },
              "additionalProperties": false
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemRepairing": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [],
          "properties": {
            "stage": {
              "const": "repairing"
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {
                "store": {
                  "const": true
                },
                "card": {
                  "const": false
                }
              },
              "additionalProperties": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "itemBlocked": {
      "allOf": [
        {
          "$ref": "../vault-item.schema.json#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "reason"
          ],
          "properties": {
            "stage": {
              "const": [
                "blocked",
                "review",
                "dupes",
                "quarantine"
              ]
            },
            "presence": {
              "type": "object",
              "required": [
                "store",
                "card"
              ],
              "properties": {},
              "additionalProperties": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "scanRequest": {
      "type": "object",
      "required": [
        "store_root",
        "domains"
      ],
      "properties": {
        "store_root": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "hash_mode": {
          "type": "string",
          "enum": [
            "none",
            "new",
            "all"
          ]
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "planAction": {
      "type": "object",
      "required": [
        "item_id",
        "action",
        "step",
        "priority"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "classify",
            "fetch",
            "transform",
            "verify",
            "publish",
            "cleanup",
            "skip",
            "block"
          ]
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer"
        },
        "ticket_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "reconcileReport": {
      "type": "object",
      "required": [
        "checked_at",
        "store_items",
        "card_items",
        "missing_count",
        "extra_count",
        "hash_mismatch_count",
        "stage_counts"
      ],
      "properties": {
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "store_items": {
          "type": "integer",
          "minimum": 0
        },
        "card_items": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "extra_count": {
          "type": "integer",
          "minimum": 0
        },
        "hash_mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "stage_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "runSummary": {
      "type": "object",
      "required": [
        "run_id",
        "workflow",
        "status",
        "started_at",
        "finished_at",
        "counts",
        "warnings"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "partial"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
