{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset updated event",
  "type": "object",
  "required": [
    "domain",
    "date",
    "path",
    "sha256",
    "item_count"
  ],
  "properties": {
    "domain": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
