{
  "schema": 1,
  "owner": "gardusi-gustavo",
  "host": "github.com",
  "root": "~/github",
  "layout": "github/<prefix>/<repo>",
  "source_of_truth": "governance/repos.json",
  "domains": [
    {
      "domain": "contracts",
      "prefix": "contract",
      "repos": [
        "contract-graphql",
        "contract-json",
        "contract-openapi",
        "contract-proto",
        "contract-sql",
        "contract-wit"
      ]
    },
    {
      "domain": "dashboards",
      "prefix": "dashboard",
      "repos": [
        "dashboard-devops",
        "dashboard-lottery",
        "dashboard-news",
        "dashboard-stocks",
        "dashboard-wiki"
      ]
    },
    {
      "domain": "databases",
      "prefix": "database",
      "repos": [
        "database-devops",
        "database-lottery",
        "database-news",
        "database-stocks",
        "database-wiki"
      ]
    },
    {
      "domain": "games",
      "prefix": "game",
      "repos": [
        "game-crosswords",
        "game-logic-grid",
        "game-sudoku"
      ]
    },
    {
      "domain": "packages",
      "prefix": "package",
      "repos": [
        "package-cpp",
        "package-cs",
        "package-docker",
        "package-elixir",
        "package-go",
        "package-java",
        "package-kotlin",
        "package-lua",
        "package-md",
        "package-php",
        "package-python",
        "package-rb",
        "package-rs",
        "package-scala",
        "package-sh",
        "package-swift",
        "package-terraform",
        "package-ts",
        "package-ui",
        "package-zig",
        "package-wat"
      ]
    },
    {
      "domain": "workflows",
      "prefix": "workflow",
      "repos": [
        "workflow-event",
        "workflow-manual",
        "workflow-scheduled"
      ]
    },
    {
      "domain": "github",
      "prefix": "meta",
      "repos": [
        "package-yml",
        "gardusi-gustavo"
      ]
    }
  ],
  "excluded": [
    {
      "repo": "gardusi-gustavo/private",
      "auth": "operator_ssh_only",
      "reason": "Operator-only via SSH; no automation, no workflow access"
    }
  ],
  "auth": {
    "mode": "ssh-operator-and-github-token",
    "operator": "~/.ssh/id_ed25519_github",
    "workflow_token": "GITHUB_TOKEN",
    "scope": "per repository",
    "personal_access_tokens": "none",
    "github_apps": "none",
    "never_grant": [
      "administration",
      "repository deletion",
      "organization administration"
    ]
  }
}
