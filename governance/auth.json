{
  "schema": 2,
  "owner": "gardusi-gustavo",
  "host": "github.com",
  "operator": {
    "auth": "ssh",
    "key_type": "ed25519",
    "allows": [
      "git:read",
      "git:write",
      "workflow_files:via_git"
    ],
    "forbidden": [
      "administration",
      "actions:write"
    ]
  },
  "workflows": {
    "auth": "GITHUB_TOKEN",
    "scope": "repository",
    "note": "Every workflow declares its own permissions; the token is scoped to the repository that runs it",
    "permissions": {
      "pull_request": ["contents:read"],
      "push_tag": ["contents:write"],
      "schedule": ["contents:read", "issues:write"],
      "pages": ["contents:read", "pages:write", "id-token:write"]
    }
  },
  "forbidden": [
    "personal_access_tokens",
    "github_apps",
    "cross_repo_tokens",
    "administration"
  ],
  "private_repository": {
    "access": "operator_ssh_only",
    "automation": false
  }
}
