{
  "schema": 2,
  "season": "build",
  "seasons": {
    "build": {
      "focus_min": 210,
      "review_min": 120,
      "chat_min": 45,
      "inbox_min": 30,
      "merged_prs": 10,
      "ai_usd": 1.0
    },
    "maintain": {
      "focus_min": 120,
      "review_min": 60,
      "chat_min": 30,
      "inbox_min": 15,
      "merged_prs": 3,
      "ai_usd": 0.4
    }
  },
  "inbox": {
    "source": "chat",
    "repository": "gardusi-gustavo/gardusi-gustavo",
    "unit": "one chat = one parent issue",
    "capture_anytime": true,
    "delete_after_capture": true
  },
  "budgets": {
    "ai_usd": {
      "low": 0.5,
      "high": 1.5,
      "target": 1.0,
      "window": "day"
    },
    "review_min": {
      "low": 60,
      "high": 180,
      "target": 120,
      "window": "day"
    },
    "chat_min": {
      "low": 30,
      "high": 90,
      "target": 45,
      "window": "day"
    },
    "inbox_min": {
      "low": 15,
      "high": 45,
      "target": 30,
      "window": "day"
    },
    "focus_min": {
      "low": 120,
      "high": 300,
      "target": 210,
      "window": "day"
    },
    "merged_prs": {
      "low": 5,
      "high": 15,
      "target": 10,
      "window": "day"
    },
    "new_issues": {
      "low": 5,
      "high": 15,
      "target": 10,
      "window": "day"
    }
  },
  "queues": {
    "inbox": {
      "resume": 80,
      "pause": 100
    },
    "per_repo": {
      "resume": 15,
      "pause": 20,
      "ready": 1,
      "drafts": 2
    }
  },
  "scheduler": {
    "mode": "focus",
    "one_repo_per_run": true,
    "stop_below": "P3",
    "tiebreak": [
      "priority",
      "oldest_queued",
      "name"
    ],
    "preempt": "manual_p0_only",
    "draft_ttl_days": 7
  },
  "priorities": [
    "P0",
    "P1",
    "P2",
    "P3"
  ],
  "stages": [
    "captured",
    "triaged",
    "specced",
    "queued",
    "generating",
    "review",
    "done",
    "failed"
  ],
  "review": {
    "minutes_per_pr": 12,
    "cooling_off_hours": 4,
    "max_files": 4,
    "max_changed_lines": 250,
    "max_commits": 5,
    "checklist": [
      "correctness",
      "evidence",
      "scope",
      "tests",
      "rollback"
    ],
    "merge_in_same_session": false,
    "order": "repo_priority"
  },
  "flow": {
    "readability_gate": true,
    "required_spec_sections": [
      "problem",
      "evidence",
      "acceptance",
      "non_goals",
      "rollback"
    ],
    "one_pr_one_issue": true,
    "append_only": true,
    "max_children_per_parent": 8,
    "fanout_unit": "repo_outcome"
  },
  "aging": {
    "inbox_someday_days": 30,
    "repo_stale_days": 60,
    "someday_close_days": 90
  },
  "labels": {
    "source": "source:chat",
    "spec_ready": "spec:ready",
    "parked": "parked",
    "someday": "someday",
    "stale": "stale",
    "focus": "focus:repo"
  },
  "schedule": {
    "order": [
      "review",
      "ops",
      "ideation",
      "triage"
    ],
    "triage_batch": 10
  },
  "rituals": {
    "daily": "review first, inbox at the end of the day",
    "weekly": "triage, close stale, report oldest queued issue per repo",
    "monthly": "restore drill, token rotation, prune someday older than 90 days"
  }
}
